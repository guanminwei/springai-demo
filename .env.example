# ==================== AI API Key（多服务商兼容）====================
# 优先级：专属 Key > 统一兜底 Key
# 同时使用多个服务商 → 分别设置各自的 Key
# 只用单个服务商   → 只设 AI_API_KEY 即可

# 统一兜底 Key（所有模块的默认回退值）
AI_API_KEY=

# --- 各服务商专属 Key（替换为你自己的 Key）---
# 智谱 (ZhipuAI)       → open.bigmodel.cn
ZHIPUAI_API_KEY=

# 硅基流动 (SiliconFlow) → api.siliconflow.cn
SILICON_API_KEY=

# 讯飞星火 (Spark)       → spark-api-open.xf-yun.com
SPARK_API_KEY=

# 阿里百炼/DashScope     → dashscope.aliyuncs.com
DASHBOARD_API_KEY=
